# Django & Database
DJANGO_SECRET_KEY=change-me-in-local-env-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database (PostgreSQL primary; set USE_SQLITE=true only for local quickstart without Postgres)
USE_SQLITE=false
DB_ENGINE=django.db.backends.postgresql
DB_NAME=reciperelay
DB_USER=reciperelay_user
DB_PASSWORD=change-me-db-password
DB_HOST=localhost
DB_PORT=5432

# LLM Provider Configuration (mock | openai | gemini | openai_compatible)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=10

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000/api

# SonarQube (optional local/CI)
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=
